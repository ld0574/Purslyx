# 运行时必须从 201 的本地开发环境注入，不要把真实密码写入仓库。
# 密码包含 URL 特殊字符时，优先用 PGPASSWORD，避免未编码的连接串解析错误。
DATABASE_URL=postgresql+psycopg://purslyx@10.10.10.201:5432/purslyx
PGPASSWORD=<password-from-local-development-file>

# 任务队列暂不作为最小演示链路的前置依赖；启用 worker 时再配置。
REDIS_URL=redis://<redis_host>:6379/0

PURSLYX_TOKEN_SECRET=<at-least-32-random-characters>
PURSLYX_DEBUG=false
PURSLYX_AUTO_CREATE_SCHEMA=true
PURSLYX_DATA_DIR=/var/lib/purslyx
PURSLYX_MODEL_PROVIDER=local
PURSLYX_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PURSLYX_PRODUCT_ORIGIN=http://127.0.0.1:8000
