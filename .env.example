# 生产 Docker 部署：PostgreSQL、Redis 在宿主机，容器通过 host.docker.internal 访问。
# 密码包含 URL 特殊字符时，优先使用 PGPASSWORD，避免连接串解析错误。
DATABASE_URL=postgresql+psycopg://purslyx@host.docker.internal:5432/purslyx
PGPASSWORD=<postgres-password>
PURSLYX_ALLOWED_DATABASE_HOSTS=host.docker.internal

# 当前 Worker 的任务 outbox 仍由 PostgreSQL 持久化；Redis 为宿主机预留的缓存/队列基础设施。
REDIS_URL=redis://:<redis-password>@host.docker.internal:6379/0

PURSLYX_TOKEN_SECRET=<at-least-32-random-characters>
PURSLYX_DEBUG=false
PURSLYX_ENVIRONMENT=production
# 注册默认不要求邮箱认证；改为 true 后恢复验证邮件流程。
PURSLYX_REQUIRE_EMAIL_VERIFICATION=false
PURSLYX_AUTO_CREATE_SCHEMA=false
PURSLYX_EXECUTION_MODE=worker
# 容器内路径，保持为 /var/lib/purslyx；宿主机 upload/ 通过下面的挂载路径映射到这里。
PURSLYX_DATA_DIR=/var/lib/purslyx
# 宿主机路径；应用实际写入 upload/files 和 upload/exports。
PURSLYX_DATA_DIR_HOST=./upload
# 发布脚本会按槽位写入 /data/purslyx/logs/api1 和 /data/purslyx/logs/api2，旧槽位日志不会随容器删除。
PURSLYX_LOG_ROOT_HOST=/data/purslyx/logs
# 直接执行 docker compose 时使用；release.sh deploy 会覆盖为对应槽位目录。
PURSLYX_LOG_DIR_HOST=./logs
# 单个 api.log/worker.log 文件达到 50 MiB 后轮转，最多保留 10 个历史文件。
PURSLYX_LOG_MAX_BYTES=52428800
PURSLYX_LOG_BACKUP_COUNT=10
# 生产全链路 AI；本地离线测试才使用 local。
PURSLYX_MODEL_PROVIDER=openai
PURSLYX_MODEL=gpt-4.1-mini
PURSLYX_MODEL_REASONING_EFFORT=none
OPENAI_API_KEY=<openai-api-key>
# 官方 OpenAI 可留空；OpenAI-compatible 服务填写其 Chat Completions API base URL（通常以 /v1 结尾）。
OPENAI_BASE_URL=
# 美元／百万 token，按实际模型价格填写，否则预算层会拒绝调用。
PURSLYX_MODEL_INPUT_USD_PER_MILLION=0.40
PURSLYX_MODEL_CACHED_INPUT_USD_PER_MILLION=0.10
PURSLYX_MODEL_OUTPUT_USD_PER_MILLION=1.60
PURSLYX_ALLOWED_ORIGINS=https://purslyx.com
PURSLYX_PRODUCT_ORIGIN=https://purslyx.com
PURSLYX_ALLOWED_BROWSER_ORIGINS=https://www.zhipin.com,https://zhipin.com,https://www.liepin.com,https://liepin.com
PURSLYX_COOKIE_SECURE=true

# 双槽位发布脚本会覆盖这些变量；默认值用于首次 purslyx-api1 部署。
PURSLYX_API_PORT=18001
PURSLYX_NETWORK_NAME=purslyx-api1
PURSLYX_NETWORK_SUBNET=172.29.109.0/24
PURSLYX_APP_CONTAINER_NAME=purslyx-api1
PURSLYX_WORKER_CONTAINER_NAME=purslyx-worker1

# 首次初始化管理员时临时设置，执行 scripts/init_201.py 后可以移除。
PURSLYX_ADMIN_EMAIL=
PURSLYX_ADMIN_PASSWORD=

# 仅在 PURSLYX_REQUIRE_EMAIL_VERIFICATION=true 或使用密码／账号恢复邮件时配置。
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM="Purslyx <no-reply@example.com>"
SMTP_STARTTLS=true
